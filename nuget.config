<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet のパッケージを nuget.org からだけ取得する。
  開発者のマシンのユーザー・マシン単位の設定に別のソース（社内のフィードなど）があっても使わず、
  同じ名前のパッケージを別のソースから取得してしまうこと（dependency confusion）を防ぐ。
  Windows 版のテスト（Windows/）と、変換コマンドの C# 実装の Native AOT のビルド（converters/）の両方に効くよう、ルートに置く。
  https://learn.microsoft.com/nuget/concepts/security-best-practices
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
