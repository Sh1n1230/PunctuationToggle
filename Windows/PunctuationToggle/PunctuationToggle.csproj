<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>PunctuationToggle</RootNamespace>
    <AssemblyName>PunctuationToggle</AssemblyName>
    <!-- macOS や Linux でもビルド（コンパイルの確認）だけはできるようにする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- P/Invoke を LibraryImport（コンパイル時にマーシャリングのコードを生成する）で宣言するのに必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PunctuationToggle.Core\PunctuationToggle.Core.csproj" />
  </ItemGroup>

</Project>
