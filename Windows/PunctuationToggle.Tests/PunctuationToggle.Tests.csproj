<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows に依存しない Core のテスト（macOS・Linux でも実行できる）。
       レジストリなど Windows でしか動かない部分は PunctuationToggle.WindowsTests でテストする -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- テストメソッド名を日本語の説明にしているため、命名規則の警告は出さない -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- 外部のパッケージを使うのはテストのプロジェクトだけなので、ここで packages.lock.json に固定する
         （版は ../Directory.Packages.props）。CI では lock ファイルと食い違うと復元を失敗させる -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- CI でカバレッジを集計する（dotnet test の collect 引数に "XPlat Code Coverage" を渡す） -->
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PunctuationToggle.Core\PunctuationToggle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- macOS 版と共通のテストベクタ（TriggerKeyVectorTests が読む） -->
  <ItemGroup>
    <None Include="..\..\testdata\trigger_key_vectors.json" Link="testdata\trigger_key_vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
