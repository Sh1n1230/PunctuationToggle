<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows でしか動かない部分（レジストリの読み書きと変更通知）のテスト。CI の Windows のジョブで実行する。
       テストは HKCU\Software\PunctuationToggle.Tests の下だけを使い、実際の IME の設定や Run キーには書き込まない -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- macOS や Linux でもビルド（dotnet format の確認）だけはできるようにする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <!-- テストメソッド名を日本語の説明にしているため、命名規則の警告は出さない -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PunctuationToggle\PunctuationToggle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
